# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.
# En producción, estas variables se configuran en Vercel (Settings → Environment Variables).

# Base de datos (Neon, cadena de conexión "pooled")
DATABASE_URL=

# Almacenamiento de imágenes (Vercel Blob, almacén con acceso PÚBLICO)
BLOB_READ_WRITE_TOKEN=

# Administrador (una sola cuenta)
ADMIN_EMAIL=
# Contraseña: define UNA de las dos (si defines las dos, manda el hash).
# Opción sencilla: contraseña en texto (12+ caracteres, única), como variable «Sensitive» en Vercel.
ADMIN_PASSWORD=
# Opción recomendada a medio plazo: hash generado con  npm run admin:hash
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres:  openssl rand -base64 48
# Si la cambias, se cierran todas las sesiones.
AUTH_SECRET=

# Solo desarrollo/CI: sirve contenido de ejemplo sin base de datos. No usar en producción.
# USE_SAMPLE_DATA=1
