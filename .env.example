# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.
# Los valores reales se configuran en el panel del hosting, no en el repositorio.

# Fase 4 — Base de datos (PostgreSQL, p. ej. Neon)
DATABASE_URL=

# Fase 4 — Almacenamiento de imágenes (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Fase 4 — Autenticación del administrador
AUTH_SECRET=
ADMIN_EMAIL=
